# Provide exactly one provider key. The client auto-detects which one is set
# (priority: OpenAI > Anthropic > Gemini > Groq).
#
# Free-tier options (no credit card):
#   Gemini: https://aistudio.google.com/apikey   (~15 req/min, 1500/day)
#   Groq:   https://console.groq.com/keys        (30 req/min, 1000/day)
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults are pinned in sentinelflow/config.py)
# SENTINELFLOW_MODEL=gemini-3.5-flash-lite
# SENTINELFLOW_TEMPERATURE=0.0
